# KonomiTV の CM 解析ランタイム (thirdparty/CMAnalysis) のビルド元を固定するマニフェスト
# docker/thirdparty/build-cm-analysis.sh から source されて参照される
#
# 移植元 (makeding/HonomiTV) では全サードパーティーのバージョンをこのファイルで管理しているが、
# 本リポジトリでは CM 解析以外のバージョンを .github/workflows/build_thirdparty.yaml の env で
# 管理しているため、二重管理を避けるべく CM 解析ランタイムに必要な定義のみを残している

# FFmpeg 8 (FFMS2 が読み込む LGPL 互換の専用ビルド)
FFMPEG8_VERSION=8.1.2
FFMPEG8_TAG=n8.1.2
FFMPEG8_REPOSITORY=https://github.com/FFmpeg/FFmpeg.git
FFMPEG8_COMMIT=38b88335f99e76ed89ff3c93f877fdefce736c13
FFMPEG8_LICENSE_SHA256=2e1d16c72fd74e12063776371da757322f8b77589386532f4fd8634bde7de1af
FFMPEG8_LGPLV21_SHA256=246041b6ecf9bc32d718a62c57877c78b5eb397b6467e74ed7ae2626ab189c30

# AviSynth+ (chapter_exe / logoframe のスクリプト実行環境)
AVISYNTHPLUS_REPOSITORY=https://github.com/AviSynth/AviSynthPlus.git
AVISYNTHPLUS_COMMIT=fc5b9bc41fd47001b7da39ea777d29c0ede2a2a7
AVISYNTHPLUS_TAG=v3.7.3
AVISYNTHPLUS_LICENSE_SHA256=1f5f360a07ceae385d1cb7f2e95eaf43070a4609d965985ad60df1783ef1acc5

# FFMS2 (AviSynth+ から録画ファイルを索引付きで読むためのソースフィルター)
FFMS2_VERSION=5.1.2
FFMS2_REPOSITORY=https://github.com/FFMS/ffms2.git
FFMS2_COMMIT=3af2ef2ae47bc30b64597c9e419e5b19c4bda7d8
FFMS2_LICENSE_SHA256=321c1b9fbed050f434128289c4ae7319901b5aa4b57053b3dbe3a4e334af57bd
FFMS2_HARDWARE_DECODING_PATCH_SHA256=f6c2ba0bacd4b5996596262f7b81917dca6ec94fe880224230e59d67a6a2bfd6

# chapter_exe (無音・シーンチェンジからチャプター候補を抽出する)
CHAPTER_EXE_REPOSITORY=https://github.com/rigaya/chapter_exe.git
CHAPTER_EXE_COMMIT=32880d45f088e574285a101e6a49b032bb04f6ea
CHAPTER_EXE_LICENSE_SHA256=8177f97513213526df2cf6184d8ff986c675afb514d4e68a404010521b880643
CHAPTER_EXE_AVISYNTH_INIT_PATCH_SHA256=a600b31b149a9cd3d1c62608a2d3452d4db927b236f3ed59c102b69239fb3b63

# logoframe (放送局ロゴの有無をフレーム単位で判定する)
LOGOFRAME_VERSION=1.20
LOGOFRAME_REPOSITORY=https://github.com/tobitti0/logoframe.git
LOGOFRAME_COMMIT=c93aec0c89838e9b4dd3a9a3d5496dfaaa41311d
LOGOFRAME_LICENSE_SHA256=8177f97513213526df2cf6184d8ff986c675afb514d4e68a404010521b880643
LOGOFRAME_ERROR_LIFETIME_PATCH_SHA256=3b3c8351a027586f58ca415a9d7a6750f8cb90e2c069bc099da18db222a0906c
LOGOFRAME_PARALLEL_SCAN_PATCH_SHA256=fb2841957546a1cfc72df32ea22ea19b06e39e25c44773b8d9d9c988eed74939
LOGOFRAME_NATIVE_LUMA_PATCH_SHA256=0e9d388204debe4e58c9954232db263f908a22574c319a646caaf641684a2a46
LOGOFRAME_HIGH_BIT_RGB_FALLBACK_PATCH_SHA256=344d300bdbe5199301c9518634f9927be9710eef9f06e42a5da330ed6c04f235

# join_logo_scp (ロゴとチャプター候補を突き合わせて CM 区間を確定する)
JOIN_LOGO_SCP_REPOSITORY=https://github.com/tobitti0/join_logo_scp.git
JOIN_LOGO_SCP_COMMIT=d1a24d758f8b3c04352b82ff6756fdf3d56729b3
JOIN_LOGO_SCP_LICENSE_SHA256=8177f97513213526df2cf6184d8ff986c675afb514d4e68a404010521b880643
